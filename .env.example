# Copy to .env (next to manage.py) and adjust. Never commit the real .env file.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# Development defaults. In production set DEBUG=False and list your real host names.
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
# Production over HTTPS only (ignored when DEBUG=True):
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# Used for absolute links in notification emails.
SITE_URL=http://127.0.0.1:8020

# Emails print to the console by default. For real email, set an SMTP backend:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Harvest <noreply@example.com>

# Display currency for prices.
CURRENCY_SYMBOL=€
